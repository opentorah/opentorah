<?xml version="1.0" encoding="UTF-8"?>
<!--
  The custom hierarchy. A custom with no `parent` is a root; every other
  custom inherits a reading from its parent when it states none of its own
  (see Custom.Of.find). Kept here rather than in the enum so the tree can be
  read and changed as data; Custom.scala checks this file covers every value.
  
  TODO merge with Custo.xml?
-->
<CustomTree>
  <custom n="Common"/>
  <custom n="Ashkenaz"       parent="Common"/>
  <custom n="Italki"         parent="Ashkenaz"/>
  <custom n="Frankfurt"      parent="Ashkenaz"/>
  <custom n="Poznan"         parent="Ashkenaz"/>
  <custom n="Lita"           parent="Ashkenaz"/>
  <custom n="Chayey Odom"    parent="Lita"/>
  <custom n="Hagra"          parent="Ashkenaz"/>
  <custom n="Sefard"         parent="Common"/>
  <custom n="Chabad"         parent="Sefard"/>
  <custom n="Pure Sephardim" parent="Sefard"/>
  <custom n="Persia"         parent="Sefard"/>
  <custom n="Libya"          parent="Sefard"/>
  <custom n="Magreb"         parent="Sefard"/>
  <custom n="Algeria"        parent="Magreb"/>
  <custom n="Algiers"        parent="Algeria"/>
  <custom n="Toshbim"        parent="Magreb"/>
  <custom n="Djerba"         parent="Magreb"/>
  <custom n="Morocco"        parent="Magreb"/>
  <custom n="Fes"            parent="Morocco"/>
  <!-- Marrakesh stands for Bogmaz too: Asulin never separates them, and no
       reading we have tells them apart. -->
  <custom n="Marrakesh"      parent="Morocco"/>
  <custom n="Agadir"         parent="Morocco"/>
  <custom n="Bavlim"         parent="Sefard"/>
  <custom n="Teiman"         parent="Sefard"/>
  <custom n="Baladi"         parent="Teiman"/>
  <custom n="Shami"          parent="Teiman"/>

  <!--
    Romania is neither Ashkenaz nor Sefard. hamichlol notes that its readings
    follow the old Erets Yisrael rite, "לעומת מנהגי שאר העדות שמבוססים על המנהג
    הבבלי": as against the other rites, which follow the Babylonian custom.
    Parenting it to either would make its fallback claim the wrong tradition, so
    it hangs off Common and states its own readings.

    It says the same again of a particular reading: "ונראה שמנהג זה מבוסס על
    מסורה ארצישראלית, כמו רוב ההפטרות של רומניא": it appears this practice
    rests on an Erets Yisrael tradition, as do most of the Romania haftarot.
  -->
  <custom n="Romania"        parent="Common"/>
</CustomTree>
