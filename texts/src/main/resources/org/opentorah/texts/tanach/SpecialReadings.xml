        <aliyah n="10" fromVerse="39"/>
        <aliyah n="11" fromVerse="42"/>
        <aliyah n="12" fromVerse="45"/>
        <aliyah n="13" fromVerse="48"/>
        <aliyah n="14" fromVerse="51"/>
        <aliyah n="15" fromVerse="54"/>
        <aliyah n="16" fromVerse="57"/>
        <aliyah n="17" fromVerse="60"/>
