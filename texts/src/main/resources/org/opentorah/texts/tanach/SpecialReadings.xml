<?xml version="1.0" encoding="UTF-8"?>
<!--
  Readings for days that are not ordinary Shabbosos, keyed by occasion.
  Children of `day` are `torah`, `maftir` or `haftarah`. Distinguish extras
  with `when` (shabbos, afternoon), `role` (korbanot, additional, …) and
  `n` (Pesach intermediate 3/4/6, Chanukah shabbos 1/2). `partial="true"`:
  the custom map need not cover everyone.

  Torah `from`/`to` are chapter:verse; aliyah 1 may be omitted; `to` on an
  aliyah is implied by the next start unless written. Haftarah grammar is
  the same as Haftarah.xml (custom / span / reads / variant). Date logic
  that chooses among these lives in SpecialReadings.scala.
-->
<specialReadings>
  <day n="ErevRoshChodesh">
    <haftarah when="shabbos" book="I Samuel">
      <custom n="Common">
        <span from="20:18" to="20:42"/>
      </custom>
    </haftarah>
    <haftarah when="shabbos" role="additional" partial="true">
      <custom n="Chabad" sources="chabad-haftarot" book="I Samuel">
        <span from="20:18"/>
        <span from="20:42"/>
        <comment>chabad.org states the rule directly: on a Shabbos that is Rosh Chodesh and also the eve of Rosh Chodesh, the first and last verse of Machar Chodesh follow the haftarah that was read. Fes reads the same two verses, on the older evidence these two customs were recorded together on.</comment>
      </custom>
      <custom n="Fes" book="I Samuel">
        <span from="20:18"/>
        <span from="20:42"/>
      </custom>
    </haftarah>
  </day>
