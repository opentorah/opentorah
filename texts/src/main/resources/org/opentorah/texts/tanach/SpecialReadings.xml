        <custom n="Ashkenaz" fromVerse="16" toVerse="18"/>
        <custom n="Italki" fromVerse="18" toVerse="11"/>
        <custom n="Sefard, Poznan" fromVerse="18" toVerse="15"
                comment="Poznan reads with Sefard here, per hamichlol. hamichlol documents the Poznan readings from the community pinkas (poznan-pinkas)."/>
        <custom n="Teiman" fromVerse="9" toVerse="11"/>
      </haftarah>
    </reading>
  </day>
  <day n="ShabbosHagodol">
    <reading n="haftarah">
