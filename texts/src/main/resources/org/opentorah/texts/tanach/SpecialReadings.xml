<?xml version="1.0" encoding="UTF-8"?>
<!--
  The readings for the days that are not ordinary Shabbosos, keyed by the
  occasion they belong to, the way Torah.xml and Haftarah.xml are keyed by
  parsha. What is left in SpecialReadings.scala is the logic that chooses
  among these: which occasion a date is, whether it is Shabbos, a weekday or
  an afternoon, which day of Chanukah or Succos, and whether it is the Holy
  Land. See issue #370.
-->
<specialReadings>
  <day n="ErevRoshChodesh">
    <reading n="shabbosHaftarah">
      <haftarah book="I Samuel" fromChapter="20" fromVerse="18" toVerse="42"/>
    </reading>
    <reading n="shabbosAdditionalHaftarah" full="false">
      <haftarah>
        <custom n="Chabad, Fes" book="I Samuel" fromChapter="20">
          <part n="1" fromVerse="18" toVerse="18"/>
          <part n="2" fromVerse="42" toVerse="42"/>
        </custom>
      </haftarah>
    </reading>
  </day>
  <day n="RoshChodesh">
    <reading n="torah">
      <torah book="Numbers" fromChapter="28" fromVerse="1" toVerse="15">
        <aliyah n="2" fromVerse="3"/>
        <aliyah n="3" fromVerse="4"/>
        <aliyah n="4" fromVerse="6"/>
        <aliyah n="5" fromVerse="9"/>
        <aliyah n="6" fromVerse="11"/>
      </torah>
    </reading>
    <reading n="shabbosHaftarah">
      <haftarah book="Isaiah" fromChapter="66">
        <part n="1" fromVerse="1" toVerse="24"/>
        <part n="2" fromVerse="23" toVerse="23"/>
      </haftarah>
    </reading>
    <reading n="shabbosAdditionalHaftarah" full="false">
      <haftarah>
        <custom n="Chabad" book="Isaiah" fromChapter="66">
          <part n="1" fromVerse="1" toVerse="1"/> <!-- first verse of the common haftarah -->
          <part n="2" fromVerse="23" toVerse="24"/> <!-- last verse of the common haftarah -->
          <part n="3" fromVerse="23" toVerse="23"/>
        </custom>
      </haftarah>
    </reading>
  </day>
  <day n="FestivalEnd">
    <reading n="shabbosTorah">
